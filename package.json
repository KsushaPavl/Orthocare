{
  "name": "orthocare-site",
  "version": "1.0.0",
  "description": "OrthoCare static website (GitHub Pages)",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./src/dist/output.css",
    "watch": "tailwindcss -i ./src/input.css -o ./src/dist/output.css --watch",
    "start": "npx serve src",
    "publish": "sh scripts/publish.sh",
    "build:site": "sh scripts/build.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1"
  }
}
